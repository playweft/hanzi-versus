{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/hanzi-versus/",
  "version": "0.1.0",
  "protocol": { "min": 1, "max": 1 },
  "start_url": "./index.html",
  "name": "Hanzi Versus",
  "name_localized": { "zh-CN": "诗词对决" },
  "description": "Use AI clues to race toward the hidden idiom.",
  "description_localized": { "zh-CN": "根据 AI 生成的二字词组，抢答隐藏的四字成语。" },
  "categories": ["word", "strategy", "party"],
  "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
  "background_color": "#f5f0e5",
  "theme_color": "#123d3b",
  "orientation": "portrait",
  "modes": {
    "solo": {},
    "room": {
      "players": { "min": 2, "max": 2 },
      "server": { "runtime": "lua", "entry": "./game.lua", "persistence": "durable" }
    }
  }
}
