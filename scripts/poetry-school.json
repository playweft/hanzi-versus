        "莲叶何田田",
        "鱼戏莲叶间",
        "鱼戏莲叶东",
        "鱼戏莲叶西",
        "鱼戏莲叶南",
        "鱼戏莲叶北"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 2,
      "title": "长歌行",
      "author": "汉乐府",
      "lines": [
        "青青园中葵",
        "朝露待日晞",
        "阳春布德泽",
        "万物生光辉",
        "常恐秋节至",
        "焜黄华叶衰",
        "百川东到海",
        "何时复西归",
        "少壮不努力",
        "老大徒伤悲"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 3,
      "title": "敕勒歌",
      "author": "北朝民歌",
      "lines": [
        "风吹草低见牛羊"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 4,
      "title": "咏鹅",
      "author": "骆宾王",
      "lines": [
        "曲项向天歌",
        "白毛浮绿水",
        "红掌拨清波"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 5,
      "title": "风",
      "author": "李峤",
      "lines": [
        "解落三秋叶",
        "能开二月花",
        "过江千尺浪",
        "入竹万竿斜"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 6,
      "title": "咏柳",
      "author": "贺知章",
      "lines": [
        "碧玉妆成一树高",
        "万条垂下绿丝绦",
        "不知细叶谁裁出",
        "二月春风似剪刀"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 7,
      "title": "回乡偶书",
      "author": "贺知章",
      "lines": [
        "少小离家老大回",
        "乡音无改鬓毛衰",
        "儿童相见不相识",
        "笑问客从何处来"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 8,
      "title": "凉州词",
      "author": "王之涣",
      "lines": [
        "黄河远上白云间",
        "一片孤城万仞山",
        "羌笛何须怨杨柳",
        "春风不度玉门关"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 9,
      "title": "登鹳雀楼",
      "author": "王之涣",
      "lines": [
        "白日依山尽",
        "黄河入海流",
        "欲穷千里目",
        "更上一层楼"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 10,
      "title": "春晓",
      "author": "孟浩然",
      "lines": [
        "春眠不觉晓",
        "处处闻啼鸟",
        "夜来风雨声",
        "花落知多少"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 11,
      "title": "凉州词",
      "author": "王翰",
      "lines": [
        "葡萄美酒夜光杯",
        "欲饮琵琶马上催",
        "醉卧沙场君莫笑",
        "古来征战几人回"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 12,
      "title": "出塞二首·其一",
      "author": "王昌龄",
      "lines": [
        "秦时明月汉时关",
        "万里长征人未还",
        "但使龙城飞将在",
        "不教胡马度阴山"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 13,
      "title": "芙蓉楼送辛渐",
      "author": "王昌龄",
      "lines": [
        "寒雨连江夜入吴",
        "平明送客楚山孤",
        "洛阳亲友如相问",
        "一片冰心在玉壶"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 14,
      "title": "鹿柴",
      "author": "王维",
      "lines": [
        "空山不见人",
        "但闻人语响",
        "返景入深林",
        "复照青苔上"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 15,
      "title": "渭城曲",
      "author": "王维",
      "lines": [
        "渭城朝雨浥轻尘",
        "客舍青青柳色新",
        "劝君更尽一杯酒",
        "西出阳关无故人"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 16,
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "lines": [
        "独在异乡为异客",
        "每逢佳节倍思亲",
        "遥知兄弟登高处",
        "遍插茱萸少一人"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 17,
      "title": "静夜思",
      "author": "李白",
      "lines": [
        "床前明月光",
        "疑是地上霜",
        "举头望明月",
        "低头思故乡"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 18,
      "title": "古朗月行",
      "author": "李白",
      "lines": [
        "小时不识月",
        "呼作白玉盘",
        "又疑瑶台镜",
        "飞在青云端"
      ],
      "selectionNote": "明确节选，未自动收录长篇全文",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 19,
      "title": "望庐山瀑布",
      "author": "李白",
      "lines": [
        "日照香炉生紫烟",
        "遥看瀑布挂前川",
        "飞流直下三千尺",
        "疑是银河落九天"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 20,
      "title": "赠汪伦",
      "author": "李白",
      "lines": [
        "李白乘舟将欲行",
        "忽闻岸上踏歌声",
        "桃花潭水深千尺",
        "不及汪伦送我情"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 21,
      "title": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "lines": [
        "故人西辞黄鹤楼",
        "烟花三月下扬州",
        "孤帆远影碧空尽",
        "唯见长江天际流"
      ],
      "selectionNote": "明确节选，未自动收录长篇全文",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 22,
      "title": "早发白帝城",
      "author": "李白",
      "lines": [
        "朝辞白帝彩云间",
        "千里江陵一日还",
        "两岸猿声啼不住",
        "轻舟已过万重山"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 23,
      "title": "望天门山",
      "author": "李白",
      "lines": [
        "天门中断楚江开",
        "碧水东流至此回",
        "两岸青山相对出",
        "孤帆一片日边来"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 24,
      "title": "别董大",
      "author": "高适",
      "lines": [
        "千里黄云白日曛",
        "北风吹雁雪纷纷",
        "莫愁前路无知己",
        "天下谁人不识君"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 25,
      "title": "绝句",
      "author": "杜甫",
      "lines": [
        "两个黄鹂鸣翠柳",
        "一行白鹭上青天",
        "窗含西岭千秋雪",
        "门泊东吴万里船"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 26,
      "title": "春夜喜雨",
      "author": "杜甫",
      "lines": [
        "好雨知时节",
        "当春乃发生",
        "随风潜入夜",
        "润物细无声",
        "野径云俱黑",
        "江船火独明",
        "晓看红湿处",
        "花重锦官城"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 27,
      "title": "绝句",
      "author": "杜甫",
      "lines": [
        "迟日江山丽",
        "春风花草香",
        "泥融飞燕子",
        "沙暖睡鸳鸯"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 28,
      "title": "江畔独步寻花",
      "author": "杜甫",
      "lines": [
        "黄师塔前江水东",
        "春光懒困倚微风",
        "桃花一簇开无主",
        "可爱深红爱浅红"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 29,
      "title": "枫桥夜泊",
      "author": "张继",
      "lines": [
        "月落乌啼霜满天",
        "江枫渔火对愁眠",
        "姑苏城外寒山寺",
        "夜半钟声到客船"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 30,
      "title": "滁州西涧",
      "author": "韦应物",
      "lines": [
        "独怜幽草涧边生",
        "上有黄鹂深树鸣",
        "春潮带雨晚来急",
        "野渡无人舟自横"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 31,
      "title": "游子吟",
      "author": "孟郊",
      "lines": [
        "慈母手中线",
        "游子身上衣",
        "临行密密缝",
        "意恐迟迟归",
        "谁言寸草心",
        "报得三春晖"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 32,
      "title": "早春呈水部张十八员外",
      "author": "韩愈",
      "lines": [
        "天街小雨润如酥",
        "草色遥看近却无",
        "最是一年春好处",
        "绝胜烟柳满皇都"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 33,
      "title": "渔歌子",
      "author": "张志和",
      "lines": [
        "西塞山前白鹭飞",
        "桃花流水鳜鱼肥",
        "斜风细雨不须归"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 34,
      "title": "塞下曲",
      "author": "卢纶",
      "lines": [
        "月黑雁飞高",
        "单于夜遁逃",
        "欲将轻骑逐",
        "大雪满弓刀"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 35,
      "title": "望洞庭",
      "author": "刘禹锡",
      "lines": [
        "湖光秋月两相和",
        "潭面无风镜未磨",
        "遥望洞庭山水色",
        "白银盘里一青螺"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 36,
      "title": "浪淘沙",
      "author": "刘禹锡",
      "lines": [
        "九曲黄河万里沙",
        "浪淘风簸自天涯",
        "如今直上银河去",
        "同到牵牛织女家"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 37,
      "title": "赋得古原草送别",
      "author": "白居易",
      "lines": [
        "离离原上草",
        "一岁一枯荣",
        "野火烧不尽",
        "春风吹又生"
      ],
      "selectionNote": "明确节选，未自动收录长篇全文",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 38,
      "title": "池上",
      "author": "白居易",
      "lines": [
        "小娃撑小艇",
        "偷采白莲回",
        "不解藏踪迹",
        "浮萍一道开"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 39,
      "title": "忆江南",
      "author": "白居易",
      "lines": [
        "风景旧曾谙",
        "日出江花红胜火",
        "春来江水绿如蓝",
        "能不忆江南"
      ],
      "selectionNote": "明确节选，未自动收录长篇全文",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 40,
      "title": "小儿垂钓",
      "author": "胡令能",
      "lines": [
        "蓬头稚子学垂纶",
        "侧坐莓苔草映身",
        "路人借问遥招手",
        "怕得鱼惊不应人"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 41,
      "title": "悯农",
      "author": "李绅",
      "lines": [
        "锄禾日当午",
        "汗滴禾下土",
        "谁知盘中餐",
        "粒粒皆辛苦"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 42,
      "title": "悯农",
      "author": "李绅",
      "lines": [
        "春种一粒粟",
        "秋收万颗子",
        "四海无闲田",
        "农夫犹饿死"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 43,
      "title": "江雪",
      "author": "柳宗元",
      "lines": [
        "千山鸟飞绝",
        "万径人踪灭",
        "孤舟蓑笠翁",
        "独钓寒江雪"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 44,
      "title": "寻隐者不遇",
      "author": "贾岛",
      "lines": [
        "松下问童子",
        "言师采药去",
        "只在此山中",
        "云深不知处"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 45,
      "title": "山行",
      "author": "杜牧",
      "lines": [
        "远上寒山石径斜",
        "白云生处有人家",
        "停车坐爱枫林晚",
        "霜叶红于二月花"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 46,
      "title": "清明",
      "author": "杜牧",
      "lines": [
        "清明时节雨纷纷",
        "路上行人欲断魂",
        "借问酒家何处有",
        "牧童遥指杏花村"
      ],
      "selectionNote": "取所列原文的完整五字、七字句",
      "tier": "basic"
    },
    {
      "stage": "primary",
      "number": 47,
      "title": "江南春",
